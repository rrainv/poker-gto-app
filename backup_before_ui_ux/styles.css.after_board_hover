:root {

  --bg: #1e1f22;

  --panel: #2b2d31;

  --panel2: #313338;

  --line: #3f4147;

  --text: #f2f3f5;

  --muted: #949ba4;

  

  --primary: #5865f2;

  --primary-hover: #4752c4;

  

  --orange: #f59e0b;

  --red: #da373c;

  --purple: #8b5cf6;

  

  --primary-rgb: 88, 101, 242;

  --theme-act1: var(--primary);

  --theme-act2: #23a55a;

  --theme-act3: var(--red);

  

  /* Matrix Colors */

  --matrix-open: #da373c;

  --matrix-call: #5865f2;

  --matrix-mix: #949ba4;

  --matrix-fold: #383a40;

  --matrix-check: #23a55a;

  

  /* Card Suits */

  --heart: #ff0000;

  --spade: #f2f3f5;

  --diamond: #0044ff;

  --club: #00b300;

  

  --shadow: 0 20px 50px rgba(0, 0, 0, 0.4);

  

  /* Smooth transitions */

  --transition-fast: 0.15s ease;

  --transition-normal: 0.25s ease;

  --transition-slow: 0.4s ease;

}



