/**

 * Terminal Theme - CRT-style retro terminal appearance

 * Fixed font-family and suit colors for better visibility

 */

[data-theme="terminal"] {

  --bg: #050a05;

  --panel: #0a120a;

  --panel2: #0f1a0f;

  --line: rgba(0, 255, 102, 0.3);

  --text: #00ff66;

  --muted: #66aa66;

  --primary: #00ff66;

  --primary-hover: #00ff88;

  --primary-rgb: 0, 255, 102;

  --theme-act1: #00ff66;

  --theme-act2: #ffcc00;

  --theme-act3: #ff3344;

  --theme-gradient: rgba(10, 20, 13, 0.96);

  --page-glow: #020603;

  --theme-panel: rgba(10, 20, 13, 0.98);

  --shadow: 0 0 20px rgba(0, 255, 102, 0.1);

  --matrix-open: #00ff66;

  --matrix-call: #00e5ff;

  --matrix-mix: #ffcc00;

  --matrix-fold: #1a3320;

  --matrix-check: #00ff66;

  

  /* Fix suit colors for visibility on dark terminal background */

  --spade: #cccccc;

  --club: #00e5ff;

}



[data-theme="terminal"] .panel {

  border: 1px solid var(--line) !important;

  box-shadow: 0 0 15px rgba(0, 255, 102, 0.08), inset 0 0 30px rgba(0, 255, 102, 0.02) !important;

  background: linear-gradient(145deg, rgba(10, 20, 13, 0.98), rgba(5, 10, 5, 0.99)) !important;

}



[data-theme="terminal"] .panel-head {

  border-bottom: 1px solid var(--line) !important;

  background: rgba(0, 255, 102, 0.03) !important;

}



[data-theme="terminal"] .panel-head::before {

  content: "> ";

  color: var(--primary);

  font-family: 'Fira Code', 'Consolas', 'Courier New', monospace;

  font-weight: bold;

  margin-right: 4px;

  text-shadow: 0 0 5px rgba(0, 255, 102, 0.5);

}



[data-theme="terminal"] .card-slot {

  border: 1px solid var(--line) !important;

  background: rgba(6, 18, 8, 0.8) !important;

  box-shadow: inset 0 0 10px rgba(0, 255, 102, 0.1) !important;

  transition: all 0.2s ease !important;

}



[data-theme="terminal"] .card-slot:hover {

  border-color: var(--primary) !important;

  box-shadow: inset 0 0 15px rgba(0, 255, 102, 0.2), 0 0 10px rgba(0, 255, 102, 0.3) !important;

}



[data-theme="terminal"] button,

[data-theme="terminal"] input,

[data-theme="terminal"] select,

[data-theme="terminal"] .matrix-cell {

  font-family: 'Consolas', 'Courier New', monospace !important;

  border: 1px solid var(--line) !important;

  background: rgba(0, 20, 0, 0.6) !important;

  color: var(--text) !important;

}



[data-theme="terminal"] button:hover,

[data-theme="terminal"] select:hover {

  border-color: var(--primary) !important;

  box-shadow: 0 0 8px rgba(0, 255, 102, 0.3) !important;

}



[data-theme="terminal"] .tab.active {

  background: rgba(0, 255, 102, 0.15) !important;

  border-color: var(--primary) !important;

  box-shadow: 0 0 10px rgba(0, 255, 102, 0.2) !important;

}



[data-theme="terminal"] .cta {

  background: linear-gradient(135deg, rgba(0, 255, 102, 0.2), rgba(0, 255, 102, 0.1)) !important;

  border: 1px solid var(--primary) !important;

  box-shadow: 0 0 15px rgba(0, 255, 102, 0.2) !important;

}



[data-theme="terminal"] .cta:hover {

  background: linear-gradient(135deg, rgba(0, 255, 102, 0.3), rgba(0, 255, 102, 0.2)) !important;

  box-shadow: 0 0 20px rgba(0, 255, 102, 0.4) !important;

}



