* { box-sizing: border-box; }



body {

  margin: 0;

  background: radial-gradient(circle at 88% -10%, var(--page-glow, #1e293b) 0, transparent 35%), var(--bg);

  color: var(--text);

  font: 14px/1.4 Inter, ui-sans-serif, system-ui, -apple-system, sans-serif;

  min-height: 100vh;

  pointer-events: auto;

  transition: background 0.3s ease, color 0.3s ease;

}



button, input, select { font: inherit; }

button { cursor: pointer; }

button:focus-visible, input:focus-visible, select:focus-visible {

  outline: 2px solid var(--primary);

  outline-offset: 2px;

}



.shell { max-width: 1480px; margin: auto; padding: 26px 24px 46px; }



header {

  display: flex;

  justify-content: space-between;

  align-items: center;

  gap: 18px;

  margin-bottom: 25px;

}



.brand { display: flex; gap: 12px; align-items: center; }



.brand-mark {

  width: 42px;

  height: 42px;

  border-radius: 13px;

