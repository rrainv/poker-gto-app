.panel-title { font-weight: 750; font-size: 14px; }

.panel-note { color: var(--muted); font-size: 11px; margin-block-start: 3px; }

.panel-body { padding-block: 15px 17px; padding-inline: 17px; }



.fields { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

.field.full { grid-column: 1 / -1; }

label { display: block; color: var(--muted); font-size: 11px; font-weight: 650; margin-block-end: 5px; }



select, input[type=number] {

  appearance: none;

  -webkit-appearance: none;

  width: 100%;

  border-radius: 9px;

  border: 1px solid var(--line);

  background: #0b1120;

  color: var(--text);

  padding-block: 9px;

  padding-inline: 9px;

}



