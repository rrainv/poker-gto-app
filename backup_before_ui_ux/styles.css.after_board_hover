  display: grid;

  place-items: center;

  color: #fff;

  font-size: 24px;

  box-shadow: 0 10px 24px rgba(59, 130, 246, 0.22);

}



h1, h2, h3, p { margin: 0; }

h1 { font-size: 20px; letter-spacing: -.5px; }



.eyebrow, .label {

  font-size: 10px;

  letter-spacing: .12em;

  text-transform: uppercase;

  color: var(--muted);

  font-weight: 700;

}



.subtitle { color: var(--muted); margin-top: 2px; font-size: 12px; }



.chip, .status {

  border: 1px solid var(--line);

  color: var(--muted);

  border-radius: 99px;

  padding: 7px 10px;

  font-size: 11px;

  white-space: nowrap;

}



.status i {

  width: 7px;

  height: 7px;

  background: var(--primary);

  border-radius: 50%;

  display: inline-block;

  margin-right: 7px;

