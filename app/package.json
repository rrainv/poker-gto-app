{
  "name": "riverline-poker-workstation",
  "private": true,
  "version": "1.0.0",
  "description": "Desktop Texas Hold'em strategy and analysis workstation",
  "main": "main.js",
  "author": "Riverline Development Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "electron-dev": "electron . --dev",
    "dist": "electron-builder --win",
    "dist-portable": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.riverline.poker",
    "productName": "Riverline Poker Workstation",
    "asar": true,
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "src/**/*",
      "node_modules/@supabase/supabase-js/dist/umd/supabase.js",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,tests,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin"
    ],
    "extraResources": [
      {
        "from": "../shared/poker-domain",
        "to": "shared/poker-domain",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Riverline Poker Workstation"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3"
  }
}
